# snapshots with no code consumer.
AUDIT_REPORT.md
AUDIT_ROUND2.md
FIX_STATUS.md
PROJECT_TEXT_ZH_AUDIT.md
UNTRANSLATED_UI_STRINGS.md
remaining_untranslated.csv
*.swp
*~
app.asar.bak

# Localization run artifacts (QA reports, merge plans, pre-merge backups)
.l10n/

# Workspace-local pytest scratch directory (sandboxes without a writable %TEMP%)
.pytest_tmp/

# Logs and databases
*.log

